# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Stripe (for Phase 2)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# OpenAI — powers training chat, embeddings, and the public website coach.
OPENAI_API_KEY=your_openai_api_key

# Resend — used for assessment + website coach summary emails.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=will@awakeningdestiny.global
RESEND_REPLY_TO=will@awakeningdestiny.global

# Website coaching agent (Phase 1–3)
# Model used for /api/coach/chat. Default: gpt-4.1-mini.
COACH_MODEL=gpt-4.1-mini
# Model used for /api/coach/summary. Default: gpt-4.1-mini.
COACH_SUMMARY_MODEL=gpt-4.1-mini
# Number of free questions a visitor gets before the lead-form gate.
COACH_FREE_QUESTION_LIMIT=5
# Where to send team-side lead summary emails. Defaults to RESEND_REPLY_TO.
COACH_TEAM_EMAIL=will@awakeningdestiny.global
# Token required to call /api/coach/ingest (admin-only KB ingestion).
COACH_INGEST_TOKEN=set_a_long_random_string
